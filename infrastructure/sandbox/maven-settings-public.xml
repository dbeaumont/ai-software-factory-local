<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>approved-mirror</id>
      <name>Configured unauthenticated Maven mirror</name>
      <url>${env.MAVEN_MIRROR_URL}</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
  <proxies>
    <proxy>
      <id>sandbox-egress</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>${env.MAVEN_PROXY_HOST}</host>
      <port>3128</port>
      <nonProxyHosts>${env.MAVEN_NO_PROXY_HOSTS}</nonProxyHosts>
    </proxy>
    <proxy>
      <id>sandbox-egress-https</id>
      <active>true</active>
      <protocol>https</protocol>
      <host>${env.MAVEN_PROXY_HOST}</host>
      <port>3128</port>
      <nonProxyHosts>${env.MAVEN_NO_PROXY_HOSTS}</nonProxyHosts>
    </proxy>
  </proxies>
</settings>
