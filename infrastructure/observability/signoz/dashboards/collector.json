  "spec": {
    "display": {
      "name": "AI Factory OpenTelemetry Collector",
      "description": "Santé, débit, refus et files du Collector OpenTelemetry local."
    },
    "variables": [
      {
        "kind": "TextVariable",
        "spec": {
          "name": "task_id",
          "display": {
            "name": "Task identifier",
            "description": "Paste an ai.task.id value to pivot to traces, logs and the task API."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "role",
          "display": {
            "name": "Agent role",
            "description": "Bounded ai.agent.role or role value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "operation",
          "display": {
            "name": "Operation",
            "description": "Bounded ai.operation value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "outcome",
          "display": {
            "name": "Result",
            "description": "Bounded ai.outcome or outcome value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "model",
          "display": {
            "name": "LLM model",
            "description": "Bounded gen_ai.request.model value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "mcp_server",
          "display": {
            "name": "MCP service",
            "description": "Bounded server or mcp.server.name value."
          },
          "value": "",
          "constant": false
        }
      }
    ],
    "panels": {
      "0b6589fe-a0b1-59f3-b9f5-aef9f45fd3d5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Accepted telemetry",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "promql",
                        "spec": {
                          "name": "A",
                          "query": "sum by (receiver) (rate(otelcol_receiver_accepted_spans[5m]))",
                          "disabled": false,
                          "step": 0,
                          "stats": false,
                          "legend": ""
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "B",
                          "query": "sum by (receiver) (rate(otelcol_receiver_accepted_metric_points[5m]))",
                          "disabled": false,
                          "step": 0,
                          "stats": false,
                          "legend": ""
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "C",
                          "query": "sum by (receiver) (rate(otelcol_receiver_accepted_log_records[5m]))",
                          "disabled": false,
                          "step": 0,
                          "stats": false,
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Search traces",
              "url": "/trace",
              "renderVariables": true
            },
            {
              "name": "Search logs",
              "url": "/logs-explorer",
              "renderVariables": true
            },
            {
              "name": "Temporal UI",
              "url": "http://localhost:8233",
              "renderVariables": true
            },
            {
              "name": "Task API",
              "url": "http://localhost:8088/api/tasks/$task_id",
              "renderVariables": true
            },
            {
              "name": "Observability runbooks",
              "url": "https://github.com/dbeaumont/ai-software-factory-local/tree/main/docs/operations/runbooks",
              "renderVariables": true
            }
          ]
        }
      },
