                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "promql",
                        "spec": {
                          "name": "A",
                          "query": "histogram_quantile(0.95, sum by (le, provider, model) (rate(ai_factory_llm_request_duration_seconds_bucket[5m])))",
                          "disabled": false,
                          "step": 0,
                          "stats": false,
                          "legend": ""
