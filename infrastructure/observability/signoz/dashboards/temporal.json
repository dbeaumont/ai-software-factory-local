  "spec": {
    "display": {
      "name": "AI Factory Temporal",
      "description": "Santé, débit, latence et persistance Temporal collectés par le receiver du Collector."
    },
    "variables": [
      {
        "kind": "TextVariable",
        "spec": {
          "name": "task_id",
          "display": {
            "name": "Task identifier",
            "description": "Paste an ai.task.id value to pivot to traces, logs and the task API."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "role",
          "display": {
            "name": "Agent role",
            "description": "Bounded ai.agent.role or role value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "operation",
          "display": {
            "name": "Operation",
            "description": "Bounded ai.operation value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "outcome",
          "display": {
            "name": "Result",
            "description": "Bounded ai.outcome or outcome value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "model",
          "display": {
            "name": "LLM model",
            "description": "Bounded gen_ai.request.model value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "mcp_server",
          "display": {
            "name": "MCP service",
            "description": "Bounded server or mcp.server.name value."
          },
          "value": "",
          "constant": false
        }
      }
    ],
    "panels": {
      "1e265f8e-6ee8-51f0-8090-8168c3245d26": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Temporal scrape readiness",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "promql",
                        "spec": {
                          "name": "A",
                          "query": "up{job=\"temporal\"}",
                          "disabled": false,
                          "step": 0,
                          "stats": false,
                          "legend": ""
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Search traces",
              "url": "/trace",
              "renderVariables": true
            },
            {
              "name": "Search logs",
              "url": "/logs-explorer",
              "renderVariables": true
            },
