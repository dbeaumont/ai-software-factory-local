    "variables": [
      {
        "kind": "TextVariable",
        "spec": {
          "name": "task_id",
          "display": {
            "name": "Task identifier",
            "description": "Paste an ai.task.id value to pivot to traces, logs and the task API."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "role",
          "display": {
            "name": "Agent role",
            "description": "Bounded ai.agent.role or role value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "operation",
          "display": {
            "name": "Operation",
            "description": "Bounded ai.operation value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "outcome",
          "display": {
            "name": "Result",
            "description": "Bounded ai.outcome or outcome value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "model",
          "display": {
            "name": "LLM model",
            "description": "Bounded gen_ai.request.model value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "mcp_server",
          "display": {
            "name": "MCP service",
            "description": "Bounded server or mcp.server.name value."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "temporal_namespace",
          "display": {
            "name": "Temporal namespace",
            "description": "Namespace containing the workflow execution."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "workflow_id",
          "display": {
            "name": "Temporal workflow ID",
            "description": "Workflow execution identifier from traces or the task API."
          },
          "value": "",
          "constant": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "run_id",
          "display": {
            "name": "Temporal run ID",
            "description": "Optional run identifier used for an exact history deep link."
          },
          "value": "",
          "constant": false
        }
