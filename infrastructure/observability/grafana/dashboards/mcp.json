{
  "title": "AI Factory MCP",
  "uid": "ai-factory-mcp",
  "description": "Appels, latence, erreurs, retries et concurrence des serveurs MCP.",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries", "title": "MCP call rate",
      "targets": [{"expr": "sum by (server, outcome) (rate(mcp_client_calls_total[5m]))", "legendFormat": "{{server}} {{outcome}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries", "title": "MCP latency p95",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, server) (rate(mcp_client_duration_seconds_bucket[5m])))", "legendFormat": "{{server}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries", "title": "MCP retries and errors",
      "targets": [
        {"expr": "sum by (server) (rate(mcp_client_retries_total[5m]))", "legendFormat": "retry {{server}}"},
        {"expr": "sum by (server) (rate(mcp_client_errors_total[5m]))", "legendFormat": "error {{server}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries", "title": "MCP in-flight calls",
      "targets": [{"expr": "sum by (server) (mcp_client_inflight)", "legendFormat": "{{server}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ]
}
