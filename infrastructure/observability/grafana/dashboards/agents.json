{
  "title": "AI Factory Agents",
  "uid": "ai-factory-agents",
  "description": "Usage, coût, latence et fiabilité par rôle d'agent.",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries", "title": "Token rate by role and direction",
      "targets": [{"expr": "sum by (role, direction) (rate(ai_agent_tokens_total[5m]))", "legendFormat": "{{role}} {{direction}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries", "title": "Cost rate by role",
      "targets": [{"expr": "sum by (role) (rate(ai_agent_cost_micros_total[5m])) / 1000000", "legendFormat": "{{role}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries", "title": "Agent latency p95",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, role) (rate(ai_agent_duration_seconds_bucket[5m])))", "legendFormat": "{{role}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries", "title": "Agent outcomes",
      "targets": [{"expr": "sum by (role, outcome) (rate(ai_agent_duration_seconds_count[5m]))", "legendFormat": "{{role}} {{outcome}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ]
}
