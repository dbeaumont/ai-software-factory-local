{
  "title": "AI Factory Supervisor",
  "uid": "ai-factory-supervisor",
  "description": "Décisions, topologie et événements de consolidation du Supervisor.",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries", "title": "Supervisor executions",
      "targets": [{"expr": "sum by (outcome) (rate(ai_agent_duration_seconds_count{role=\"supervisor\"}[5m]))", "legendFormat": "{{outcome}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries", "title": "Replans, contradictions and escalations",
      "targets": [{"expr": "sum by (event) (rate(ai_workflow_events_total{event=~\"replan|contradiction|escalation\"}[5m]))", "legendFormat": "{{event}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries", "title": "Delegation fan-out",
      "targets": [{"expr": "max by (role) (ai_delegation_fan_out_max)", "legendFormat": "{{role}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries", "title": "Delegation depth",
      "targets": [{"expr": "max by (role) (ai_delegation_depth_max)", "legendFormat": "{{role}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ]
}
