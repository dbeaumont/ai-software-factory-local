{
  "title": "AI Factory Global",
  "uid": "ai-factory-global",
  "description": "Vue globale de santé et de flux de l'usine logicielle multi-agent.",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests",
      "targets": [{"expr": "rate(http_server_requests_seconds_count[5m])", "legendFormat": "{{method}} {{uri}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Factory tasks",
      "targets": [{"expr": "sum(ai_factory_tasks_submitted_total)", "legendFormat": "submitted"}, {"expr": "sum(ai_factory_tasks_completed_total)", "legendFormat": "validated"}, {"expr": "sum(ai_factory_tasks_failed_total)", "legendFormat": "failed"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Agent success ratio",
      "targets": [{"expr": "sum(rate(ai_agent_duration_seconds_count{outcome=\"success\"}[5m])) / clamp_min(sum(rate(ai_agent_duration_seconds_count[5m])), 1e-9)", "legendFormat": "success"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Task queue saturation",
      "targets": [{"expr": "max by (perimeter) (ai_task_queue_saturation_ratio)", "legendFormat": "{{perimeter}}"}],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "MCP errors",
      "targets": [{"expr": "sum by (server) (rate(mcp_client_errors_total[5m]))", "legendFormat": "{{server}}"}],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}
    }
  ]
}
