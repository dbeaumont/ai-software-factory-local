# Core
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=${VAULT_OPENAI_API_KEY:-}
LITELLM_MASTER_KEY=local-dev-litellm-key
AI_FACTORY_CLOUD_ENABLED=true
ORCHESTRATOR_PORT=8088
WEB_APP_PORT=8080
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222

# Gitea 
# Admin credentials
GITEA_ADMIN_USER=aiadmin
GITEA_ADMIN_PASSWORD=ChangeMe123!
GITEA_ADMIN_EMAIL=aiadmin@example.local
# Separate account used to review AI-authored pull requests.
GITEA_REVIEWER_USER=reviewer
GITEA_REVIEWER_PASSWORD=ChangeMe123!
GITEA_REVIEWER_EMAIL=reviewer@example.local
# Token
GITEA_TOKEN=

# Quality, artifacts and observability
SONAR_PORT=9000
NEXUS_PORT=8081
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
# SonarQube bootstrap credentials. Change them after the first bootstrap.
SONAR_ADMIN_LOGIN=admin
SONAR_ADMIN_PASSWORD=admin
# Generated automatically by `make bootstrap` when empty.
SONAR_TOKEN=
