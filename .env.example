# =============================================================================
# Models and LiteLLM gateway
# =============================================================================
# Local Ollama model used when tasks run in LOCAL mode.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
# Optional cloud model used when AI_FACTORY_CLOUD_ENABLED=true.
OPENAI_MODEL=gpt-5.6-luna
# Host:port used to obtain an enterprise TLS interception CA at LiteLLM startup.
# Leave empty to use the default api.openai.com:443.
OPENAI_CA_CERT_HOST=
# Shared API key between the orchestrator and the internal LiteLLM gateway.
LITELLM_MASTER_KEY=local-dev-litellm-key
# LiteLLM is published through GHCR, not docker hub. Specify an enterprise Docker proxy when
# direct access to GHCR is blocked by TLS inspection; leave empty for the Compose default.
# Example enterprise: docker-remote.registry.saas.cagip.group.gca/berriai/litellm:main-latest
# Example local: docker.litellm.ai/berriai/litellm:main-latest
LITELLM_IMAGE=
AI_FACTORY_CLOUD_ENABLED=true
# Versions and optional database preload used to build the sandbox image.
SYFT_VERSION=1.30.0
TRIVY_VERSION=0.69.3
TRIVY_PRELOAD_DB=false

# =============================================================================
# Host ports
# =============================================================================
ORCHESTRATOR_PORT=8088
WEB_APP_PORT=8080
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
SONAR_PORT=9000
ARTIFACTORY_PORT=8082
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# =============================================================================
# Artifactory JFROG
# =============================================================================
# Artifactory PostgreSQL connection. Keep the password only in the ignored local .env file.
ARTIFACTORY_DB_NAME=artifactory
ARTIFACTORY_DB_USER=artifactory
ARTIFACTORY_DB_PASSWORD=
# Artifactory encryption key. Generate once with: openssl rand -hex 16
# Keep this 32-character value unchanged while artifactory-data exists.
JF_SHARED_SECURITY_MASTERKEY=
# Artifactory cluster key. Generate once with: openssl rand -hex 16
# Keep this 32-character value unchanged while artifactory-data exists.
JF_SHARED_SECURITY_JOINKEY=

# =============================================================================
# Gitea bootstrap accounts (POC only; change before shared use)
# =============================================================================
# Account used to create repositories and Pull Requests.
GITEA_ADMIN_USER=aiadmin
GITEA_ADMIN_PASSWORD=ChangeMe123!
GITEA_ADMIN_EMAIL=aiadmin@example.local
# Separate account used to review AI-authored Pull Requests.
GITEA_REVIEWER_USER=reviewer
GITEA_REVIEWER_PASSWORD=ChangeMe123!
GITEA_REVIEWER_EMAIL=reviewer@example.local
# Generated by make bootstrap; do not commit a populated .env file.
GITEA_TOKEN=
# Gitea database connection used only inside the Compose network.
GITEA_DB_TYPE=postgres
GITEA_DB_HOST=gitea-db:5432
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=gitea
GITEA_ROOT_URL=http://localhost:3000/

# =============================================================================
# Quality and observability
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# SonarQube bootstrap account (POC only; change before shared use).
SONAR_ADMIN_LOGIN=admin
SONAR_ADMIN_PASSWORD=admin
# Generated by make bootstrap when empty.
SONAR_TOKEN=

# =============================================================================
# Orchestrator runtime
# =============================================================================
# Internal service addresses and paths injected into the Spring Boot application.
AI_FACTORY_LLM_BASE_URL=http://litellm:4000/v1
AI_FACTORY_LOCAL_MODEL=factory-code-local
AI_FACTORY_CLOUD_MODEL=factory-code-cloud
AI_FACTORY_WORKSPACE_ROOT=/workspace/tasks
AI_FACTORY_WORKSPACE_VOLUME=ai-software-factory_factory-workspace
AI_FACTORY_SANDBOX_IMAGE=ai-factory-sandbox:local
AI_FACTORY_SANDBOX_NETWORK=ai-factory-network
AI_FACTORY_GITEA_BASE_URL=http://gitea:3000
AI_FACTORY_GITEA_PUBLIC_BASE_URL=http://localhost:3000
AI_FACTORY_GITEA_USER=aiadmin
AI_FACTORY_SONARQUBE_URL=http://sonarqube:9000
AI_FACTORY_PROMPT_ROOT=/opt/ai-factory/resources/prompts
AI_FACTORY_MCP_ENABLED=false
AI_FACTORY_MCP_CLIENT_ENABLED=true
# DIRECT keeps the current code path; MCP_SHADOW compares MCP without changing agent input; MCP_ACTIVE uses MCP output.
AI_FACTORY_MCP_REPOSITORY_CONTEXT_MODE=DIRECT
AI_FACTORY_MCP_REPOSITORY_CONTEXT_URL=http://repository-context-mcp:8091
AI_FACTORY_MCP_REQUEST_TIMEOUT=20s
AI_FACTORY_MCP_SANDBOX_ENABLED=true
AI_FACTORY_MCP_SANDBOX_MODE=MCP_ACTIVE
AI_FACTORY_MCP_SANDBOX_URL=http://sandbox-execution-mcp:8092
AI_FACTORY_MCP_SANDBOX_POLL_INTERVAL=250ms
AI_FACTORY_MCP_SANDBOX_POLL_TIMEOUT=20m
AI_FACTORY_SANDBOX_MAX_CONCURRENT_JOBS=2
AI_FACTORY_SANDBOX_MAX_QUEUED_JOBS=32
AI_FACTORY_SANDBOX_MAX_ACTIVE_JOBS_PER_TASK=2
AI_FACTORY_SANDBOX_MAX_JOBS=500
# ISO-8601 duration applied to terminal jobs from completed_at (minimum PT1M, maximum P365D).
AI_FACTORY_SANDBOX_JOB_RETENTION=P7D
# Persisted liveness heartbeat for ACCEPTED/RUNNING jobs (minimum PT1S, maximum PT5M).
AI_FACTORY_SANDBOX_HEARTBEAT_INTERVAL=PT15S
AI_FACTORY_SANDBOX_MAX_OUTPUT_CHARS=65536
AI_FACTORY_SANDBOX_MAX_PATCH_BYTES=1048576
# Persistent controller metadata only; Compose mounts its dedicated volume at this path.
AI_FACTORY_SANDBOX_STATE_ROOT=/var/lib/ai-factory/sandbox-jobs
# Linux: use `stat -c '%g' /var/run/docker.sock`; Docker Desktop commonly accepts group 0.
DOCKER_SOCKET_GID=0
AI_FACTORY_CONTEXT_MAX_FILE_BYTES=1048576
AI_FACTORY_CONTEXT_MAX_SEARCH_FILES=1000
AI_FACTORY_CONTEXT_MAX_TREE_ENTRIES=1000
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# Corporate artifact repositories (optional)
# =============================================================================
# Set these to enterprise Artifactory virtual repositories when external Maven
# or npm access is restricted. ARTIFACTORY_TOKEN is a build secret: never commit it.
MAVEN_MIRROR_URL=
NPM_REGISTRY_URL=
NPM_REGISTRY_HOST=
ARTIFACTORY_TOKEN=
