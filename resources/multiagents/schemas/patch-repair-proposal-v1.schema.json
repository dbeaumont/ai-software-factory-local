{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/multiagents/schemas/patch-repair-proposal-v1.schema.json",
  "title": "PatchRepairProposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repair_proposal_id", "repair_task_id", "task_id", "attempt_id", "node_id", "code_task_id", "source_commit", "worktree_id", "repair_attempt", "replaces_proposal_id", "failure_kind", "failure_digest", "target_paths", "conflicting_proposal_ids", "scope_digest", "patch_digest", "files_touched", "diff_artifact", "summary", "created_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "repair_proposal_id": {"$ref": "#/$defs/id"},
    "repair_task_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "node_id": {"$ref": "#/$defs/id"},
    "code_task_id": {"$ref": "#/$defs/id"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "worktree_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "repair_attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "replaces_proposal_id": {"$ref": "#/$defs/id"},
    "failure_kind": {"enum": ["PATCH_INVALID", "PATCH_CONFLICT"]},
    "failure_digest": {"$ref": "#/$defs/digest"},
    "target_paths": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "conflicting_proposal_ids": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "scope_digest": {"$ref": "#/$defs/digest"},
    "patch_digest": {"$ref": "#/$defs/digest"},
    "files_touched": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/fileChange"}},
    "diff_artifact": {"$ref": "#/$defs/diffArtifact"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"failure_kind": {"const": "PATCH_INVALID"}}, "required": ["failure_kind"]}, "then": {"properties": {"conflicting_proposal_ids": {"maxItems": 0}}}},
    {"if": {"properties": {"failure_kind": {"const": "PATCH_CONFLICT"}}, "required": ["failure_kind"]}, "then": {"properties": {"conflicting_proposal_ids": {"minItems": 2, "maxItems": 2}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "nullableDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "fileChange": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "operation", "before_digest", "after_digest"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "operation": {"enum": ["ADD", "MODIFY", "DELETE", "RENAME"]}, "previous_path": {"$ref": "#/$defs/path"}, "before_digest": {"$ref": "#/$defs/nullableDigest"}, "after_digest": {"$ref": "#/$defs/nullableDigest"}}
    },
    "diffArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "digest", "media_type", "size_bytes"],
      "properties": {"uri": {"type": "string", "pattern": "^evidence://", "maxLength": 1024}, "digest": {"$ref": "#/$defs/digest"}, "media_type": {"const": "text/x-diff"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}}
    }
  }
}
