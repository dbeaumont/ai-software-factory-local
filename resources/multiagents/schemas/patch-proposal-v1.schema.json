{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/multiagents/schemas/patch-proposal-v1.schema.json",
  "title": "PatchProposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "code_task_id", "task_id", "attempt_id", "node_id", "source_commit", "worktree_id", "scope_digest", "patch_digest", "files_touched", "diff_artifact", "summary", "created_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "proposal_id": {"$ref": "#/$defs/id"},
    "code_task_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "node_id": {"$ref": "#/$defs/id"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "worktree_id": {"type": "string", "pattern": "^worktree-[A-Za-z0-9_-]{1,64}-[0-9a-f]{16}$"},
    "scope_digest": {"$ref": "#/$defs/digest"},
    "patch_digest": {"$ref": "#/$defs/digest"},
    "files_touched": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/fileChange"}},
    "diff_artifact": {"$ref": "#/$defs/diffArtifact"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "nullableDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "fileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "before_digest", "after_digest"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "operation": {"enum": ["ADD", "MODIFY", "DELETE", "RENAME"]},
        "previous_path": {"$ref": "#/$defs/path"},
        "before_digest": {"$ref": "#/$defs/nullableDigest"},
        "after_digest": {"$ref": "#/$defs/nullableDigest"}
      }
    },
    "diffArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest", "media_type", "size_bytes"],
      "properties": {
        "uri": {"type": "string", "pattern": "^evidence://", "maxLength": 1024},
        "digest": {"$ref": "#/$defs/digest"},
        "media_type": {"const": "text/x-diff"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    }
  }
}
