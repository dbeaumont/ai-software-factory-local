{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/multiagents/schemas/supervisor-decision-v1.schema.json",
  "title": "SupervisorDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "task_id", "attempt_id", "delegation_plan_id", "source_commit", "input_results", "contradiction_ids", "action", "current_risk_class", "proposed_risk_class", "summary", "selected_result_ids", "rejected_result_ids", "required_gates", "created_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "decision_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "delegation_plan_id": {"$ref": "#/$defs/id"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_results": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/inputResult"}},
    "contradiction_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "action": {"enum": ["CONSOLIDATE", "REPLAN", "REQUEST_MORE_EVIDENCE", "ESCALATE_TO_HUMAN", "STOP"]},
    "current_risk_class": {"$ref": "#/$defs/risk"},
    "proposed_risk_class": {"$ref": "#/$defs/risk"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 8000},
    "selected_result_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "rejected_result_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "required_gates": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["BEFORE_CODE", "BEFORE_EXTERNAL_EFFECT"]}},
    "replacement_plan_id": {"$ref": "#/$defs/id"},
    "human_decision_request_id": {"$ref": "#/$defs/id"},
    "evidence_uri": {"type": "string", "pattern": "^evidence://", "maxLength": 1024},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "CONSOLIDATE"}}}, "then": {"properties": {"selected_result_ids": {"minItems": 1}}}},
    {"if": {"properties": {"action": {"const": "REPLAN"}}}, "then": {"required": ["replacement_plan_id"]}},
    {"if": {"properties": {"action": {"const": "ESCALATE_TO_HUMAN"}}}, "then": {"required": ["human_decision_request_id"]}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "risk": {"type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"]},
    "inputResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "role", "digest", "status"],
      "properties": {
        "result_id": {"$ref": "#/$defs/id"},
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED"]}
      }
    }
  }
}
