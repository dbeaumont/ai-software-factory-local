{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/multiagents/schemas/test-assessment-v1.schema.json",
  "title": "TestAssessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "strategy_id", "task_id", "attempt_id", "source_commit", "integrated_patch_digest", "status", "executions", "totals", "failed_tests", "coverage", "missing_evidence", "evidence", "conclusion", "completed_at"],
  "properties": {
    "schema_version": {"const": "1"}, "assessment_id": {"$ref": "#/$defs/id"}, "strategy_id": {"$ref": "#/$defs/id"}, "task_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "integrated_patch_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["PASSED", "FAILED", "INCOMPLETE", "ERROR"]},
    "executions": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/execution"}},
    "totals": {"type": "object", "additionalProperties": false, "required": ["tests", "passed", "failed", "skipped", "duration_millis"], "properties": {"tests": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}, "duration_millis": {"type": "integer", "minimum": 0, "maximum": 3600000}}},
    "failed_tests": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "coverage": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}, "maxProperties": 8},
    "missing_evidence": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "evidence": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "conclusion": {"type": "string", "minLength": 1, "maxLength": 4000}, "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {"type": "object", "additionalProperties": false, "required": ["profile", "execution_id", "status", "evidence_uri", "digest"], "properties": {"profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "execution_id": {"$ref": "#/$defs/id"}, "status": {"enum": ["PASSED", "FAILED", "ERROR", "CANCELLED"]}, "evidence_uri": {"type": "string", "pattern": "^evidence://", "maxLength": 1024}, "digest": {"$ref": "#/$defs/digest"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["uri", "digest"], "properties": {"uri": {"type": "string", "pattern": "^evidence://", "maxLength": 1024}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}
