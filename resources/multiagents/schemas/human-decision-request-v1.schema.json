{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/multiagents/schemas/human-decision-request-v1.schema.json",
  "title": "HumanDecisionRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "task_id", "attempt_id", "source_commit", "gate", "risk_class", "question", "context", "options", "required_approver_roles", "object_digest", "evidence_uris", "status", "requested_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "request_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gate": {"enum": ["BEFORE_CODE", "BEFORE_EXTERNAL_EFFECT"]},
    "risk_class": {"enum": ["R2", "R3"]},
    "question": {"type": "string", "minLength": 1, "maxLength": 1000},
    "context": {"type": "string", "minLength": 1, "maxLength": 8000},
    "options": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"$ref": "#/$defs/option"}},
    "required_approver_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["PRODUCT", "ARCHITECTURE", "SECURITY", "DATA", "PLATFORM", "OPERATIONS"]}
    },
    "object_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_uris": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence://", "maxLength": 1024}},
    "status": {"enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED", "SUPERSEDED", "CANCELLED"]},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"gate": {"const": "BEFORE_EXTERNAL_EFFECT"}}}, "then": {"required": ["manifest_id"]}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "label", "description", "impacts", "reversible"],
      "properties": {
        "option_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "impacts": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "reversible": {"type": "boolean"},
        "recommended": {"type": "boolean"}
      }
    }
  }
}
