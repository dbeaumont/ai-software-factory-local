{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/multiagents/schemas/independent-review-v1.schema.json",
  "title": "IndependentReview v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "task_id", "attempt_id", "role", "source_commit", "final_manifest", "reviewed_result_ids", "checks", "open_contradiction_ids", "decision", "reasons", "required_human_gates", "evidence", "completed_at"],
  "properties": {
    "schema_version": {"const": "1"}, "review_id": {"$ref": "#/$defs/id"}, "task_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
    "role": {"const": "independent-reviewer"}, "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "final_manifest": {"type": "object", "additionalProperties": false, "required": ["manifest_id", "uri", "digest"], "properties": {"manifest_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uri": {"type": "string", "pattern": "^evidence://", "maxLength": 1024}, "digest": {"$ref": "#/$defs/digest"}}},
    "reviewed_result_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture", "code", "tests", "security", "evidence_integrity", "approval_binding"],
      "properties": {"architecture": {"$ref": "#/$defs/check"}, "code": {"$ref": "#/$defs/check"}, "tests": {"$ref": "#/$defs/check"}, "security": {"$ref": "#/$defs/check"}, "evidence_integrity": {"$ref": "#/$defs/check"}, "approval_binding": {"$ref": "#/$defs/check"}}
    },
    "open_contradiction_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "decision": {"enum": ["ACCEPT", "REJECT", "INDETERMINATE"]},
    "reasons": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "required_human_gates": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["BEFORE_CODE", "BEFORE_EXTERNAL_EFFECT"]}},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "check": {"type": "object", "additionalProperties": false, "required": ["status", "reasons", "evidence_uris"], "properties": {"status": {"enum": ["PASSED", "FAILED", "INDETERMINATE", "NOT_APPLICABLE"]}, "reasons": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}, "evidence_uris": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence://", "maxLength": 1024}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["uri", "digest"], "properties": {"uri": {"type": "string", "pattern": "^evidence://", "maxLength": 1024}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}
