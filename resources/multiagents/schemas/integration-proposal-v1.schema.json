{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/multiagents/schemas/integration-proposal-v1.schema.json",
  "title": "IntegrationProposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "task_id", "attempt_id", "delegation_plan_id", "node_id", "source_commit", "architecture_assessment_id", "strategy", "developer_tasks", "application_order", "risks", "created_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "proposal_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "delegation_plan_id": {"$ref": "#/$defs/id"},
    "node_id": {"$ref": "#/$defs/id"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "architecture_assessment_id": {"$ref": "#/$defs/id"},
    "strategy": {"enum": ["SERIAL", "PARALLEL_DISJOINT"]},
    "developer_tasks": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/developerTask"}},
    "application_order": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "risks": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "developerTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_task_id", "node_id", "scope_id", "scope_digest", "depends_on_task_ids", "success_criteria"],
      "properties": {
        "code_task_id": {"$ref": "#/$defs/id"},
        "node_id": {"$ref": "#/$defs/id"},
        "scope_id": {"$ref": "#/$defs/id"},
        "scope_digest": {"$ref": "#/$defs/digest"},
        "depends_on_task_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "success_criteria": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    }
  }
}
