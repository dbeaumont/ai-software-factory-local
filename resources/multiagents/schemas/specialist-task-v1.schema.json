{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/multiagents/schemas/specialist-task-v1.schema.json",
  "title": "SpecialistTask v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "specialist_task_id", "task_id", "attempt_id", "delegation_plan_id", "node_id", "parent_role", "role", "source_commit", "risk_class", "objective", "inputs", "scope", "allowed_tools", "budget", "success_criteria", "stop_condition", "deadline", "issued_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "specialist_task_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "delegation_plan_id": {"$ref": "#/$defs/id"},
    "node_id": {"$ref": "#/$defs/id"},
    "parent_role": {"$ref": "#/$defs/role"},
    "role": {"$ref": "#/$defs/role"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "risk_class": {"enum": ["R0", "R1", "R2", "R3"]},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "inputs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/input"}
    },
    "scope": {"$ref": "#/$defs/scope"},
    "allowed_tools": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tool"}
    },
    "budget": {"$ref": "#/$defs/budget"},
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "stop_condition": {"enum": ["SUCCESS_CRITERIA_MET", "BUDGET_EXHAUSTED", "DEADLINE_REACHED", "BLOCKED_OR_ESCALATE"]},
    "required_approval_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "deadline": {"type": "string", "format": "date-time"},
    "issued_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "role": {
      "enum": [
        "supervisor", "architecture-agent", "impact-analysis", "dependencies-contracts",
        "code-agent", "developer", "patch-repair", "test-agent", "test-design", "test-evidence",
        "security-agent", "threat-model", "security-findings"
      ]
    },
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "read_paths", "write_paths"],
      "properties": {
        "repository_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        "read_paths": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "write_paths": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "digest"],
      "properties": {
        "kind": {"enum": ["TICKET", "CONTRACT", "SPECIALIST_RESULT", "EVIDENCE", "POLICY_DECISION"]},
        "uri": {"type": "string", "minLength": 1, "maxLength": 1024},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "tool": {
      "enum": [
        "context.list_tree", "context.search_code", "context.read_file", "context.get_repository_rules",
        "context.get_dependencies", "context.get_symbols", "evidence.get_summary", "evidence.read"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_turns", "max_tokens", "max_cost_micros", "timeout_seconds", "max_tool_calls"],
      "properties": {
        "max_turns": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_cost_micros": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    }
  }
}
