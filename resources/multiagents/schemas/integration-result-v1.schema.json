{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/multiagents/schemas/integration-result-v1.schema.json",
  "title": "IntegrationResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integration_id", "task_id", "attempt_id", "source_commit", "status", "application_order", "applied_proposals", "conflicts", "integrated_commit", "integrated_patch_digest", "evidence", "completed_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "integration_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["SUCCESS", "CONFLICT", "REJECTED", "FAILED"]},
    "application_order": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "applied_proposals": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/applied"}},
    "conflicts": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/conflict"}},
    "integrated_commit": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "integrated_patch_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "evidence": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "SUCCESS"}}}, "then": {"properties": {"integrated_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "integrated_patch_digest": {"$ref": "#/$defs/digest"}, "conflicts": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "CONFLICT"}}}, "then": {"properties": {"conflicts": {"minItems": 1}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "applied": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "patch_digest", "order", "status"],
      "properties": {"proposal_id": {"$ref": "#/$defs/id"}, "patch_digest": {"$ref": "#/$defs/digest"}, "order": {"type": "integer", "minimum": 0, "maximum": 31}, "status": {"enum": ["APPLIED", "SKIPPED", "REJECTED"]}}
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["conflict_id", "proposal_ids", "paths", "type", "resolution"],
      "properties": {"conflict_id": {"$ref": "#/$defs/id"}, "proposal_ids": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "paths": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "type": {"enum": ["OVERLAPPING_SCOPE", "CONTENT", "ORDERING", "SOURCE_DRIFT", "DIGEST_MISMATCH"]}, "resolution": {"enum": ["UNRESOLVED", "SERIALIZED", "REPLAN_REQUIRED", "REPAIR_REQUIRED", "REJECTED"]}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {"uri": {"type": "string", "pattern": "^evidence://", "maxLength": 1024}, "digest": {"$ref": "#/$defs/digest"}}
    }
  }
}
