{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/multiagents/schemas/architecture-assessment-v1.schema.json",
  "title": "ArchitectureAssessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "task_id", "attempt_id", "specialist_task_id", "source_commit", "status", "summary", "impacted_components", "dependency_changes", "contract_changes", "api_impacts", "data_impacts", "constraints", "architecture_decisions", "recommended_code_scopes", "human_decisions", "risks", "evidence", "created_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "assessment_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "specialist_task_id": {"$ref": "#/$defs/id"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["COMPLETE", "PARTIAL", "BLOCKED"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 8000},
    "impacted_components": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/component"}},
    "dependency_changes": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/dependency"}},
    "contract_changes": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/contract"}},
    "api_impacts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/apiImpact"}},
    "data_impacts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/dataImpact"}},
    "constraints": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "architecture_decisions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/decision"}},
    "recommended_code_scopes": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/scope"}},
    "human_decisions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/humanDecision"}},
    "risks": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/risk"}},
    "evidence": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "kind", "paths", "impact"],
      "properties": {"component_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["MODULE", "SERVICE", "LIBRARY", "DATA", "CONTRACT", "BUILD", "INFRASTRUCTURE"]}, "paths": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/path"}}, "impact": {"type": "string", "minLength": 1, "maxLength": 2000}}
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "change", "compatibility", "reason"],
      "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 256}, "change": {"enum": ["ADD", "UPDATE", "REMOVE", "NONE"]}, "compatibility": {"enum": ["COMPATIBLE", "POTENTIALLY_BREAKING", "BREAKING", "UNKNOWN"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 1000}}
    },
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "change", "compatibility", "consumers"],
      "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 256}, "change": {"type": "string", "minLength": 1, "maxLength": 2000}, "compatibility": {"enum": ["COMPATIBLE", "BREAKING", "UNKNOWN"]}, "consumers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}}
    },
    "apiImpact": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "change", "compatibility", "consumers"],
      "properties": {"api": {"type": "string", "minLength": 1, "maxLength": 256}, "change": {"type": "string", "minLength": 1, "maxLength": 2000}, "compatibility": {"enum": ["COMPATIBLE", "BREAKING", "UNKNOWN"]}, "consumers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}}
    },
    "dataImpact": {
      "type": "object", "additionalProperties": false,
      "required": ["asset", "change", "migration_required", "compatibility"],
      "properties": {"asset": {"type": "string", "minLength": 1, "maxLength": 256}, "change": {"type": "string", "minLength": 1, "maxLength": 2000}, "migration_required": {"type": "boolean"}, "compatibility": {"enum": ["COMPATIBLE", "BREAKING", "UNKNOWN"]}}
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "rationale", "alternatives", "human_decision_required"],
      "properties": {"decision": {"type": "string", "minLength": 1, "maxLength": 1000}, "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}, "alternatives": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}, "human_decision_required": {"type": "boolean"}}
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_id", "write_paths", "depends_on_scope_ids"],
      "properties": {"scope_id": {"$ref": "#/$defs/id"}, "write_paths": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "depends_on_scope_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}
    },
    "humanDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "question", "reason", "gate"],
      "properties": {"decision_id": {"$ref": "#/$defs/id"}, "question": {"type": "string", "minLength": 1, "maxLength": 1000}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000}, "gate": {"enum": ["BEFORE_CODE", "BEFORE_EXTERNAL_EFFECT"]}}
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "class", "description", "mitigation"],
      "properties": {"category": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "class": {"enum": ["R0", "R1", "R2", "R3", "R4"]}, "description": {"type": "string", "minLength": 1, "maxLength": 2000}, "mitigation": {"type": "string", "minLength": 1, "maxLength": 2000}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {"uri": {"type": "string", "pattern": "^evidence://", "maxLength": 1024}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
