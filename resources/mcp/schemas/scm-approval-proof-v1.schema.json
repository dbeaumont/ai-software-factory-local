{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/scm-approval-proof-v1.schema.json",
  "title": "SCM approval proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "attempt_id", "repository_id", "source_sha", "patch_digest", "decision", "approver", "approved_at", "expires_at", "signature"],
  "properties": {
    "schema_version": {"const": "1"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "repository_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "patch_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"const": "APPROVED"},
    "approver": {"type": "string", "minLength": 1, "maxLength": 128},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
