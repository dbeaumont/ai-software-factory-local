{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/mcp/schemas/context-repository-rules-runtime-v1.schema.json",
  "title": "context.get_repository_rules runtime result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_commit", "rules"],
  "properties": {
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "rules": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "applicability_order", "provenance"],
        "properties": {
          "document": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "start_line", "end_line", "content", "mime_type", "sha256", "truncated"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "start_line": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 0 },
              "content": { "type": "string", "maxLength": 65536 },
              "mime_type": { "type": "string", "minLength": 1, "maxLength": 128 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "truncated": { "type": "boolean" }
            }
          },
          "applicability_order": { "type": "integer", "minimum": 1, "maximum": 20 },
          "provenance": { "type": "string", "pattern": "^repo://[A-Za-z0-9_-]{1,64}/[0-9a-f]{40}/" }
        }
      }
    }
  }
}
