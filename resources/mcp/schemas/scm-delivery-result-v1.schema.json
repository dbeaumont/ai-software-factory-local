{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.example/schemas/mcp/scm-delivery-result-v1.schema.json",
  "title": "SCM delivery result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["repositoryId", "branch", "commit", "pullRequestId", "pullRequestUrl", "draft"],
  "properties": {
    "repositoryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "branch": { "type": "string", "pattern": "^ai-factory/[A-Za-z0-9_-]{1,64}-[A-Za-z0-9_-]{1,128}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pullRequestId": { "type": "integer", "minimum": 1 },
    "pullRequestUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
    "draft": { "const": true }
  }
}
