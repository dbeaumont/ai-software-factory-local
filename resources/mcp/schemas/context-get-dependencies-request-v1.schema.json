{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/mcp/schemas/context-get-dependencies-request-v1.schema.json",
  "title": "context.get_dependencies request v1",
  "unevaluatedProperties": false,
  "allOf": [
    { "$ref": "common-envelope-v1.schema.json" },
    {
      "type": "object",
      "required": ["module"],
      "properties": {
        "module": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "ecosystem": { "type": "string", "enum": ["MAVEN", "GRADLE", "NPM", "UNKNOWN"] },
        "max_dependencies": { "type": "integer", "minimum": 1, "maximum": 2000, "default": 500 },
        "cursor": { "type": "string", "minLength": 16, "maxLength": 2048 }
      }
    }
  ]
}
