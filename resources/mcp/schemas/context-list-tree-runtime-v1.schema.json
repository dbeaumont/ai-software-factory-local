{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/mcp/schemas/context-list-tree-runtime-v1.schema.json",
  "title": "context.list_tree runtime result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_commit", "entries", "truncated"],
  "properties": {
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "entries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "size"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "type": { "type": "string", "enum": ["file", "directory"] },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "truncated": { "type": "boolean" },
    "next_cursor": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" }
  }
}
