{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/mcp/schemas/context-read-file-runtime-v1.schema.json",
  "title": "context.read_file runtime result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "start_line", "end_line", "content", "mime_type", "sha256", "truncated"],
  "properties": {
    "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "start_line": { "type": "integer", "minimum": 1 },
    "end_line": { "type": "integer", "minimum": 0 },
    "content": { "type": "string", "maxLength": 65536 },
    "mime_type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "truncated": { "type": "boolean" }
  }
}
