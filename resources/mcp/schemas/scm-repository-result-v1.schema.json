{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/mcp/schemas/scm-repository-result-v1.schema.json",
  "title": "SCM repository metadata result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["repositoryId", "owner", "name", "defaultBranch", "archived", "empty"],
  "properties": {
    "repositoryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "defaultBranch": { "type": "string", "minLength": 1, "maxLength": 255 },
    "archived": { "type": "boolean" },
    "empty": { "type": "boolean" }
  }
}
