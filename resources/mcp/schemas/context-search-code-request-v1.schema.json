{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/mcp/schemas/context-search-code-request-v1.schema.json",
  "title": "context.search_code request v1",
  "unevaluatedProperties": false,
  "allOf": [
    { "$ref": "common-envelope-v1.schema.json" },
    {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": { "type": "string", "minLength": 1, "maxLength": 256 },
        "path_globs": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "max_results": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
        "cursor": { "type": "string", "minLength": 16, "maxLength": 2048 }
      }
    }
  ]
}
