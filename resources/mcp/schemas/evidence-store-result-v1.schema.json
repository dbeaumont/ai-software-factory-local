{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/mcp/schemas/evidence-store-result-v1.schema.json",
  "title": "Evidence store result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["uri", "digest", "status", "media_type", "size_bytes", "classification", "retain_until", "stored_at"],
  "properties": {
    "uri": { "type": "string", "pattern": "^evidence://[A-Za-z0-9_-]{1,64}/[A-Za-z0-9_-]{1,128}/[^/]+/[0-9a-f]{64}$", "maxLength": 1024 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "const": "COMPLETE" },
    "media_type": { "type": "string", "minLength": 3, "maxLength": 128 },
    "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
    "classification": { "enum": ["INTERNAL", "CONFIDENTIAL", "RESTRICTED"] },
    "retain_until": { "type": "string", "format": "date-time" },
    "stored_at": { "type": "string", "format": "date-time" }
  }
}
