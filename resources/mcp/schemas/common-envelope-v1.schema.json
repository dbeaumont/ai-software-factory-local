{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/mcp/schemas/common-envelope-v1.schema.json",
  "title": "AI Factory MCP request envelope v1",
  "type": "object",
  "required": ["schema_version", "task_id", "attempt_id", "source_commit", "actor", "trace_id", "traceparent", "deadline"],
  "properties": {
    "schema_version": { "const": "1" },
    "task_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
    "attempt_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "actor": { "type": "string", "enum": ["workflow", "supervisor", "architecture-agent", "impact-analysis", "dependencies-contracts", "code-agent", "developer", "patch-repair", "test-agent", "test-design", "test-evidence", "security-agent", "threat-model", "security-findings", "independent-reviewer", "planner", "tester", "reviewer", "delivery"] },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "traceparent": { "type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$" },
    "run_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
    "delegation_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
    "agent_run_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
    "deadline": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 256 }
  }
}
