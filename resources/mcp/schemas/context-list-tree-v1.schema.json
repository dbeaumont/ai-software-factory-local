{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/mcp/schemas/context-list-tree-v1.schema.json",
  "title": "context.list_tree request v1",
  "unevaluatedProperties": false,
  "allOf": [
    { "$ref": "common-envelope-v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "path": { "type": "string", "maxLength": 1024, "default": "" },
        "depth": { "type": "integer", "minimum": 1, "maximum": 12, "default": 6 },
        "max_entries": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 }
      }
    }
  ]
}
