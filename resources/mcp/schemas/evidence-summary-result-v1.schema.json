{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/mcp/schemas/evidence-summary-result-v1.schema.json",
  "title": "Evidence summary result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["uri", "type", "digest", "status", "classification", "size_bytes"],
  "properties": {
    "uri": { "type": "string", "pattern": "^evidence://", "maxLength": 1024 },
    "type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "const": "COMPLETE" },
    "classification": { "enum": ["INTERNAL", "CONFIDENTIAL", "RESTRICTED"] },
    "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
  }
}
