{
  "schemaVersion": "1.0.0",
  "delivery": {
    "mechanism": "read-only-file-mount",
    "requiredFileMode": "0600",
    "symbolicLinksAllowed": false,
    "maximumBytes": 1048576,
    "rawEnvironmentVariablesAllowed": false
  },
  "secrets": [
    {
      "name": "orchestrator-oauth2-client",
      "consumers": ["orchestrator"],
      "pathVariable": "AI_FACTORY_A2A_OAUTH2_CLIENT_SECRET_FILE",
      "rotation": "atomic-file-replacement"
    },
    {
      "name": "agent-card-signing-jwks",
      "consumers": ["agent-role"],
      "pathVariable": "AI_FACTORY_A2A_CARD_JWK_SET_PATH",
      "rotation": "overlapping-kid-then-card-cache-invalidation"
    },
    {
      "name": "agent-mcp-access-token",
      "consumers": ["agent-role"],
      "pathVariable": "AI_FACTORY_MCP_ROLE_ACCESS_TOKEN_FILE",
      "rotation": "atomic-file-replacement"
    },
    {
      "name": "push-notification-hmac",
      "consumers": ["agent-role", "orchestrator"],
      "pathVariable": "AI_FACTORY_A2A_PUSH_HMAC_SECRET_FILE",
      "rotation": "atomic-file-replacement"
    },
    {
      "name": "workload-tls-private-key",
      "consumers": ["orchestrator", "agent-role"],
      "pathVariable": "AI_FACTORY_A2A_TLS_PRIVATE_KEY",
      "rotation": "new-certificate-before-old-certificate-revocation"
    }
  ],
  "forbiddenSinks": [
    "process-environment-values",
    "application-configuration-dumps",
    "logs",
    "traces",
    "a2a-message-parts",
    "a2a-task-metadata",
    "a2a-task-history",
    "temporal-workflow-arguments",
    "temporal-workflow-history"
  ],
  "verification": {
    "failClosedOnMissingFile": true,
    "failClosedOnUnsafePermissions": true,
    "clearTemporaryByteArrays": true,
    "readAgainAtCredentialUse": ["oauth2-client", "agent-mcp-access-token", "push-notification-hmac"]
  }
}
