  "alertRules": [
    {
      "name": "AiFactoryAgentLoopDetected",
      "state": "inactive",
      "query": "increase(ai_agent_failures_total{reason=~\"repeated_call|max_turns\"}[5m]) > 0",
      "durationSeconds": 60,
      "labels": {
        "component": "agents",
        "severity": "warning"
      },
      "annotations": {
        "description": "An agent stopped after repeating an identical call or exhausting its turn limit.",
        "runbook_url": "/docs/operations/runbooks/AGENT-DEFAILLANT.md",
        "summary": "Agent loop or turn limit detected"
      }
    },
    {
      "name": "AiFactoryAgentBudgetExhausted",
      "state": "inactive",
      "query": "increase(ai_agent_failures_total{stop_condition=\"BUDGET_EXHAUSTED\"}[5m]) > 0",
      "durationSeconds": 60,
      "labels": {
        "component": "agents",
        "severity": "warning"
      },
      "annotations": {
        "description": "A host-enforced token, cost, turn or fan-out budget stopped an agent.",
        "runbook_url": "/docs/operations/runbooks/AGENT-DEFAILLANT.md",
        "summary": "Agent execution budget exhausted"
      }
    },
    {
      "name": "AiFactoryAgentCostSpike",
      "state": "inactive",
      "query": "sum(increase(ai_agent_cost_micros_total[15m])) > 5000000",
      "durationSeconds": 300,
      "labels": {
        "component": "agents",
        "severity": "warning"
      },
      "annotations": {
        "description": "Agent usage exceeded 5,000,000 cost micros over fifteen minutes.",
        "runbook_url": "/docs/operations/runbooks/AGENT-DEFAILLANT.md",
        "summary": "Aggregate agent cost exceeds the operational threshold"
      }
    },
    {
      "name": "AiFactoryTaskQueueBacklog",
      "state": "inactive",
      "query": "max(ai_factory_sandbox_jobs_queued) > 20 or max(ai_task_queue_saturation_ratio) > 0.9",
      "durationSeconds": 600,
      "labels": {
        "component": "queues",
        "severity": "warning"
      },
      "annotations": {
        "description": "More than twenty sandbox jobs are queued or a worker perimeter remains above 90 percent saturation.",
        "runbook_url": "/docs/operations/runbooks/SATURATION.md",
        "summary": "Worker backlog or saturation is sustained"
      }
    },
    {
      "name": "AiFactorySandboxHeartbeatInvalid",
      "state": "inactive",
      "query": "increase(ai_factory_sandbox_heartbeat_invalid_total[5m]) > 0",
      "durationSeconds": 60,
      "labels": {
        "component": "sandbox",
        "severity": "critical"
      },
      "annotations": {
        "description": "The orchestrator rejected a sandbox heartbeat and failed the execution closed.",
        "runbook_url": "/docs/operations/runbooks/SANDBOX-BACKEND-INDISPONIBLE.md",
        "summary": "Sandbox execution heartbeat is absent, invalid or stale"
      }
    },
    {
      "name": "AiFactorySandboxExecutionFailures",
      "state": "inactive",
      "query": "increase(ai_factory_sandbox_jobs_failed_total[10m]) > 5",
      "durationSeconds": 300,
      "labels": {
        "component": "sandbox",
        "severity": "warning"
      },
      "annotations": {
        "description": "More than five sandbox executions failed, timed out or were cancelled in ten minutes.",
        "runbook_url": "/docs/operations/runbooks/SANDBOX-BACKEND-INDISPONIBLE.md",
        "summary": "Sandbox executions are repeatedly failing"
      }
    },
    {
      "name": "AiFactorySandboxMaintenanceFailure",
      "state": "inactive",
      "query": "increase(ai_factory_sandbox_maintenance_failures_total[10m]) > 0",
      "durationSeconds": 120,
      "labels": {
        "component": "sandbox",
        "severity": "critical"
      },
      "annotations": {
        "description": "The sandbox controller could not maintain persisted jobs or clean expired state.",
        "runbook_url": "/docs/operations/runbooks/SANDBOX-BACKEND-INDISPONIBLE.md",
        "summary": "Sandbox cleanup or retention maintenance is failing"
      }
    },
    {
      "name": "AiFactoryAgentContractError",
      "state": "inactive",
      "query": "increase(ai_agent_failures_total{stop_condition=\"CONTRACT_ERROR\"}[5m]) > 0",
      "durationSeconds": 60,
      "labels": {
        "component": "contracts",
        "severity": "warning"
      },
      "annotations": {
        "description": "An agent emitted a malformed final turn or a result outside its declared output contract.",
        "runbook_url": "/docs/operations/runbooks/AGENT-DEFAILLANT.md",
        "summary": "Agent output contract validation failed"
      }
    },
    {
      "name": "AiFactoryEvidenceAltered",
      "state": "inactive",
      "query": "increase(ai_evidence_altered_total[5m]) > 0",
      "durationSeconds": 0,
      "labels": {
        "component": "evidence",
        "severity": "critical"
      },
      "annotations": {
        "description": "Evidence MCP metadata, content or digest diverged from its workflow binding.",
        "runbook_url": "/docs/operations/runbooks/MCP-COMPROMIS.md",
        "summary": "Evidence integrity verification failed"
      }
    }
