<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example.aifactory</groupId>
  <artifactId>agent-core</artifactId>
  <version>0.1.0</version>
  <name>AI Factory Agent Core</name>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>3.1.5</jackson.version>
    <junit.version>6.0.3</junit.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>3.0.6</version>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.6</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>../../resources/agents</directory>
        <targetPath>agents</targetPath>
      </resource>
      <resource>
        <directory>../../resources/prompts</directory>
        <targetPath>prompts</targetPath>
      </resource>
      <resource>
        <directory>../../resources/multiagents/schemas</directory>
        <targetPath>multiagents/schemas</targetPath>
      </resource>
      <resource>
        <directory>../../resources/multiagents/fixtures</directory>
        <targetPath>multiagents/fixtures</targetPath>
      </resource>
      <resource>
        <directory>../../resources/mcp/schemas</directory>
        <targetPath>mcp/schemas</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>forbid-runtime-frameworks</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>org.springframework.ai:*</exclude>
                    <exclude>io.projectreactor:*</exclude>
                    <exclude>io.temporal:*</exclude>
                    <exclude>org.a2aproject.sdk:*</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
